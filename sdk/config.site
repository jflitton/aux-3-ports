# Answers for ./configure --host=m68k-apple-aux3.1, given with CONFIG_SITE: what
# configure can't learn by running a test program when cross-compiling, and so would
# guess, about libaux and A/UX. Only what's known: anything not here is left to
# configure's guess, which for gnulib means a replacement that's slower but safe.

# libaux's printf family has C99's sizes (hh h ll j z t L) and conversions, but not
# argument positions (%1$d), %a or %b, and long double goes through double.
gl_cv_func_printf_sizes_c99=yes
gl_cv_func_printf_sizes_c23=no
gl_cv_func_printf_long_double=yes
gl_cv_func_printf_infinite=yes
gl_cv_func_printf_directive_a=no
gl_cv_func_printf_directive_b=no
gl_cv_func_printf_directive_f=yes
gl_cv_func_printf_directive_ls=yes
gl_cv_func_printf_directive_lc=yes
gl_cv_func_printf_positions=no
gl_cv_func_printf_flag_grouping=yes
gl_cv_func_printf_flag_leftadjust=yes
gl_cv_func_printf_flag_zero=yes
gl_cv_func_printf_flag_alt_precision_zero=yes
gl_cv_func_printf_precision=yes
gl_cv_func_snprintf_retval_c99=yes
gl_cv_func_snprintf_truncation_c99=yes

# libaux's malloc, realloc, free, getcwd and strerror; the shared library's calloc
# allocates with libaux's malloc.
ac_cv_func_malloc_0_nonnull=yes
gl_cv_func_malloc_posix=yes
gl_cv_func_realloc_0_nonnull=yes
gl_cv_func_calloc_0_nonnull=yes
gl_cv_func_free_preserves_errno=yes
gl_cv_func_getcwd_null=yes
gl_cv_func_strerror_0_works=yes

# A/UX: open can open directories, and // is /.
gl_cv_func_open_directory_works=yes
gl_cv_double_slash_root=no
